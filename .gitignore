# .gitignore for PDF Question Answer project

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Environments & secrets
venv/
.env
*.env
*.env.*
!.env.example

# Node & Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.local

# FAISS vector store
faiss_index/

# Logs
*.log
logs/
